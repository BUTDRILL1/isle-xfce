#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Scoped helper for Isle Lightning & Super Saver power modes.
set -eu

case "${1:-}" in
    on)
        for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
            [ -w "$f" ] && printf 'performance' > "$f" || true
        done
        [ -w /sys/devices/system/cpu/cpufreq/boost ] && printf '1' > /sys/devices/system/cpu/cpufreq/boost || true
        for g in /sys/class/drm/card*/device/power_dpm_force_performance_level; do
            [ -w "$g" ] && printf 'high' > "$g" || true
        done
        ;;
    saver)
        for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
            [ -w "$f" ] && printf 'powersave' > "$f" || true
        done
        [ -w /sys/devices/system/cpu/cpufreq/boost ] && printf '0' > /sys/devices/system/cpu/cpufreq/boost || true
        for g in /sys/class/drm/card*/device/power_dpm_force_performance_level; do
            [ -w "$g" ] && printf 'low' > "$g" || true
        done
        ;;
    off)
        for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
            [ -w "$f" ] && printf 'powersave' > "$f" || true
        done
        [ -w /sys/devices/system/cpu/cpufreq/boost ] && printf '1' > /sys/devices/system/cpu/cpufreq/boost || true
        for g in /sys/class/drm/card*/device/power_dpm_force_performance_level; do
            [ -w "$g" ] && printf 'auto' > "$g" || true
        done
        ;;
    *)
        echo "Usage: isle-lightning {on|saver|off}" >&2
        exit 2
        ;;
esac
